rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isSelf(uid)   { return isSignedIn() && request.auth.uid == uid; }
    function role()        { return isSignedIn() ? request.auth.token.role : null; }
    function isAdmin()     { return role() == 'admin'; }
    function isManager()   { return role() == 'admin' || role() == 'manager'; }
    function protectedKeys() {
      return ['role', 'status', 'departmentId', 'expiresAt', 'requestedRole'];
    }
    // Tách chuỗi departmentId (có thể là nhiều mã Kho nối bằng dấu phẩy, vd "58614,12345")
    // thành danh sách — dùng cho khoData/{maKho} (mục 37 implementation_plan.md). maKho là
    // path segment (không phải query filter) nên rule "in" ở đây luôn tin cậy, không gặp
    // vướng mắc kiểu list/query đã gặp với listManagedUsers (mục 29).
    function myKhos() {
      return isSignedIn() && request.auth.token.departmentId is string
        ? request.auth.token.departmentId.replace('\\s+', '').split(',')
        : [];
    }

    match /users/{uid} {
      // Manager KHÔNG còn quyền get/list trực tiếp ở đây (trước đây isManager() cho manager
      // đọc TOÀN BỘ collection, không giới hạn Kho — lọc theo Kho chỉ nằm ở client nên không
      // phải bảo mật thật, 1 manager gọi thẳng query vẫn đọc được hồ sơ Kho khác). Manager giờ
      // đọc qua Cloud Function listManagedUsers (functions/src/admin.ts, Admin SDK bypass rules,
      // tự lọc theo Kho ở server). UserManagementView.tsx/usePendingApprovalCount.ts/
      // NotificationDropdown.tsx đã chuyển sang gọi hàm này thay vì query thẳng.
      allow get:    if isSelf(uid) || isAdmin();
      allow list:   if isAdmin();
      allow create: if isSelf(uid)
                    && !request.resource.data.keys().hasAny(protectedKeys());
      allow update: if isSelf(uid)
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedKeys());
      // Không có allow update cho isAdmin() ở đây — thay đổi role/status/departmentId/
      // expiresAt/requestedRole chỉ được thực hiện qua Cloud Function reviewAccessRequest /
      // resolveSession (Admin SDK, tự bypass Rules), không cho phép client SDK ghi thẳng
      // dù là admin hay không.

      match /setting/{doc}       { allow read, write: if isSelf(uid); }
      match /schedules/{doc}     { allow read, write: if isSelf(uid); }
      match /configs/{doc}       { allow read, write: if isSelf(uid); }
      match /salesData/{doc}     { allow read, write: if isSelf(uid); }
      match /notifications/{id}  { allow read, update: if isSelf(uid); allow create: if isSignedIn(); }
    }

    match /shared_configs/{id} {
      allow read:  if isSignedIn();
      allow write: if isManager();
    }

    // Dữ liệu doanh số DÙNG CHUNG theo Mã Kho (mục 37 implementation_plan.md) — khác với
    // users/{uid}/salesData ở trên (theo UID cá nhân, chỉ đồng bộ cho chính người tải qua
    // nhiều thiết bị của họ). Quản lý/admin tải lên 1 lần, mọi nhân viên/quản lý khác cùng
    // Kho đăng nhập trên thiết bị riêng đều đọc được — giải quyết đúng yêu cầu "nhân viên
    // thừa kế dữ liệu từ quản lý" khi mỗi người dùng thiết bị cá nhân riêng.
    match /khoData/{maKho} {
      match /salesFiles/{fileId} {
        allow read:  if isSignedIn() && maKho in myKhos();
        allow write: if isSignedIn() && isManager() && maKho in myKhos();

        match /chunks/{n} {
          allow read:  if isSignedIn() && maKho in myKhos();
          allow write: if isSignedIn() && isManager() && maKho in myKhos();
        }
      }
    }

    // Bộ đếm lượt truy cập (hooks/useSystemTraffic.ts) — không phải dữ liệu
    // nhạy cảm về phân quyền, chỉ cần đăng nhập là ghi được (giữ nguyên hành
    // vi cũ trước khi có rules, không cần qua Cloud Function).
    match /_system/{doc} {
      allow read, write: if isSignedIn();
    }

    // Dữ liệu kiểm kê kho (features/kho-hang, implementation_plan.md mục 20) — cùng mẫu
    // với khoData/{maKho} ở trên (chia sẻ theo Kho, dùng myKhos(), không qua Cloud
    // Function). Khác biệt: kiểm kê là việc nhân viên thường trực tiếp quét (không chỉ
    // quản lý) nên ITEM con cho phép MỌI thành viên Kho ghi, không giới hạn isManager()
    // như khoData/salesFiles. Nhưng doc PHIÊN (sessions/{sessionId}) — update (vd đánh dấu
    // completed) và delete — vẫn giới hạn manager/admin: nhân viên quét không bao giờ cần
    // ghi vào doc này (chỉ ghi items/{itemId}), nên siết lại không ảnh hưởng luồng quét,
    // tránh 1 nhân viên lỡ tay/cố ý kết thúc phiên hoặc xoá công sức kiểm kê của cả nhóm.
    match /inventoryChecking/{maKho} {
      match /sessions/{sessionId} {
        allow read:   if isSignedIn() && maKho in myKhos();
        allow create: if isSignedIn() && maKho in myKhos()
                      && request.resource.data.createdBy == request.auth.uid;
        allow update: if isSignedIn() && isManager() && maKho in myKhos();
        allow delete: if isSignedIn() && isManager() && maKho in myKhos();

        match /items/{itemId} {
          allow read, write: if isSignedIn() && maKho in myKhos();
        }
      }
    }
  }
}
