rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isSelf(uid)   { return isSignedIn() && request.auth.uid == uid; }
    function role()        { return isSignedIn() ? request.auth.token.role : null; }
    function isAdmin()     { return role() == 'admin'; }
    function isManager()   { return role() == 'admin' || role() == 'manager'; }
    function protectedKeys() {
      return ['role', 'status', 'departmentId', 'expiresAt', 'requestedRole'];
    }
    // Tách chuỗi departmentId (có thể là nhiều mã Kho nối bằng dấu phẩy, vd "58614,12345")
    // thành danh sách — dùng cho khoData/{maKho} (mục 37 implementation_plan.md). maKho là
    // path segment (không phải query filter) nên rule "in" ở đây luôn tin cậy, không gặp
    // vướng mắc kiểu list/query đã gặp với listManagedUsers (mục 29).
    function myKhos() {
      return isSignedIn() && request.auth.token.departmentId is string
        ? request.auth.token.departmentId.replace('\\s+', '').split(',')
        : [];
    }

    match /users/{uid} {
      // Manager KHÔNG còn quyền get/list trực tiếp ở đây (trước đây isManager() cho manager
      // đọc TOÀN BỘ collection, không giới hạn Kho — lọc theo Kho chỉ nằm ở client nên không
      // phải bảo mật thật, 1 manager gọi thẳng query vẫn đọc được hồ sơ Kho khác). Manager giờ
      // đọc qua Cloud Function listManagedUsers (functions/src/admin.ts, Admin SDK bypass rules,
      // tự lọc theo Kho ở server). UserManagementView.tsx/usePendingApprovalCount.ts/
      // NotificationDropdown.tsx đã chuyển sang gọi hàm này thay vì query thẳng.
      allow get:    if isSelf(uid) || isAdmin();
      allow list:   if isAdmin();
      allow create: if isSelf(uid)
                    && !request.resource.data.keys().hasAny(protectedKeys());
      allow update: if isSelf(uid)
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedKeys());
      // Không có allow update cho isAdmin() ở đây — thay đổi role/status/departmentId/
      // expiresAt/requestedRole chỉ được thực hiện qua Cloud Function reviewAccessRequest /
      // resolveSession (Admin SDK, tự bypass Rules), không cho phép client SDK ghi thẳng
      // dù là admin hay không.

      match /setting/{doc}       { allow read, write: if isSelf(uid); }
      match /schedules/{doc}     { allow read, write: if isSelf(uid); }
      match /salesData/{doc}     { allow read, write: if isSelf(uid); }
      match /notifications/{id}  { allow read, update: if isSelf(uid); allow create: if isSignedIn(); }

      // configs/{key} — cấu hình "nặng" (services/firestoreService.ts, isHeavySyncKey()).
      // Khoá nào vượt giới hạn 1MiB/document của Firestore (vd checkthuong_data — bảng so
      // sánh nhiều Kho/nhiều tháng) được cắt thành nhiều phần ở subcollection chunks/{n}
      // (assembleChunkedHeavyValue()) — match /configs/{doc} KHÔNG tự áp dụng cho
      // subcollection con nên phải khai báo riêng, thiếu dòng này sẽ gây permission-denied
      // im lặng khi ghi/đọc chunk dù doc cha configs/{doc} vẫn đọc/ghi bình thường.
      match /configs/{doc} {
        allow read, write: if isSelf(uid);

        match /chunks/{n} {
          allow read, write: if isSelf(uid);
        }
      }
    }

    match /shared_configs/{id} {
      allow read:  if isSignedIn();
      allow write: if isManager();
    }

    // Dữ liệu doanh số DÙNG CHUNG theo Mã Kho (mục 37 implementation_plan.md) — khác với
    // users/{uid}/salesData ở trên (theo UID cá nhân, chỉ đồng bộ cho chính người tải qua
    // nhiều thiết bị của họ). Quản lý/admin tải lên 1 lần, mọi nhân viên/quản lý khác cùng
    // Kho đăng nhập trên thiết bị riêng đều đọc được — giải quyết đúng yêu cầu "nhân viên
    // thừa kế dữ liệu từ quản lý" khi mỗi người dùng thiết bị cá nhân riêng.
    match /khoData/{maKho} {
      match /salesFiles/{fileId} {
        allow read:  if isSignedIn() && maKho in myKhos();
        allow write: if isSignedIn() && isManager() && maKho in myKhos();

        match /chunks/{n} {
          allow read:  if isSignedIn() && maKho in myKhos();
          allow write: if isSignedIn() && isManager() && maKho in myKhos();
        }
      }
    }

    // Dữ liệu Report BI (Thi đua/Summary Luỹ kế) DÙNG CHUNG theo siêu thị — implementation_plan.md
    // mục "Đợt 4". Trong thực tế công ty, 1 Kho = 1 Siêu thị (xác nhận với user 2026-08-31) nên
    // dùng LẠI đúng maKho/myKhos() ở trên — KHÔNG có custom claim allowedSupermarkets riêng.
    // Manager/admin dán dữ liệu 1 lần (uploadBiDataIfManager), mọi user cùng Kho đọc được trên
    // thiết bị riêng của họ — mirror chính xác khoData/{maKho} phía trên, chỉ khác tên collection
    // và loại dữ liệu bên trong (báo cáo BI đã parse theo siêu thị, không phải DataRow[] doanh số).
    match /biData/{maKho} {
      match /{document=**} {
        allow read:  if isSignedIn() && maKho in myKhos();
        allow write: if isSignedIn() && isManager() && maKho in myKhos();
      }
    }

    // Bảng map "tên siêu thị trong báo cáo Report BI" → "Mã Kho" — biDataService.ts dùng để
    // biết dán dữ liệu vào biData/{maKho} nào. KHÔNG dùng shared_configs ở trên (chỗ đó dành
    // cho chia sẻ cấu hình tuỳ ý giữa user, sai ngữ nghĩa cho 1 bảng tra cứu cố định duy nhất).
    // 1 document CHO MỖI Mã Kho (field names: string[]) — không còn 1 document duy nhất như
    // trước, để manager tự cấu hình được ĐÚNG Kho của mình (mirror biData/{maKho} phía trên,
    // dùng lại myKhos()). Đọc: ai đăng nhập cũng cần (để hiển thị tên đúng). Ghi: admin ghi được
    // MỌI Mã Kho kể cả Kho không thuộc myKhos() của họ (đây vẫn là bảng tra cứu toàn hệ thống,
    // admin cần toàn quyền vận hành/sửa hộ) — khác biệt CỐ Ý so với biData/{maKho} phía trên,
    // nơi admin cũng bị giới hạn myKhos(). Manager chỉ ghi được đúng (các) Kho của mình.
    match /biSupermarketMap/{maKho} {
      allow read:  if isSignedIn();
      allow write: if isAdmin() || (isManager() && maKho in myKhos());
    }

    // Bộ đếm lượt truy cập (hooks/useSystemTraffic.ts).
    //
    // SIẾT LẠI 2026-09-09 (KE_HOACH_TONG_THE.md mục 2.6). Trước đây là
    // `allow read, write: if isSignedIn()` — nghĩa là BẤT KỲ ai đăng nhập cũng
    // có thể ghi đè hoặc XOÁ TRẮNG document đếm, hoặc set totalVisits thành số
    // bất kỳ. Phía client chỉ chặn bằng sessionStorage('hasCountedVisit'), tức
    // không chặn được gì cả. Nay chỉ cho phép đúng 1 thao tác: TĂNG totalVisits
    // lên đúng 1 đơn vị. Vẫn có thể bơm số nếu gọi lặp lại, nhưng mỗi lần +1 là
    // 1 request nên chi phí tăng tuyến tính, và quan trọng hơn: không còn khả
    // năng phá huỷ (ghi đè/xoá/thêm field lạ).
    // Không chuyển sang Cloud Function vì việc đó cần deploy functions, trong
    // khi rules đã đủ diễn đạt ràng buộc này.
    match /_system/{doc} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.keys().hasOnly(['totalVisits'])
                    && request.resource.data.totalVisits == 1;
      allow update: if isSignedIn()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalVisits'])
                    && request.resource.data.totalVisits == resource.data.totalVisits + 1;
      allow delete: if false;
    }
  }
}

